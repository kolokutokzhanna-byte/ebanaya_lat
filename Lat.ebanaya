<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Латинские карточки — Анатомия</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Segoe UI', system-ui, sans-serif;
  background: linear-gradient(135deg, #ffe4ec 0%, #ffc2d9 50%, #f8a5c2 100%);
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 20px; color: #5a2a3e;
}
h1 { font-size: 1.3rem; margin-bottom: 5px; color: #c2185b; text-align:center; }
.counter { font-size: 0.95rem; color: #d81b60; margin-bottom: 15px; font-weight: 600; }
.scene { width: 100%; max-width: 520px; height: 340px; perspective: 1200px; }
.card {
  width: 100%; height: 100%; position: relative;
  transform-style: preserve-3d; transition: transform 0.6s;
  cursor: pointer; border-radius: 20px;
  box-shadow: 0 12px 35px rgba(194, 24, 91, 0.3);
}
.card.flipped { transform: rotateY(180deg); }
.face {
  position: absolute; width: 100%; height: 100%;
  backface-visibility: hidden; border-radius: 20px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 25px; text-align: center;
}
.front {
  background: linear-gradient(145deg, #fff0f5, #ffd6e7);
  border: 3px solid #f48fb1;
}
.back {
  background: linear-gradient(145deg, #ffd6e7, #ffb3d1);
  border: 3px solid #ec407a;
  transform: rotateY(180deg);
}
.front .translation {
  font-size: 2rem; font-weight: 700; color: #ad1457; line-height: 1.2;
}
.back .term {
  font-size: 1.7rem; font-weight: 700; color: #880e4f; margin-bottom: 12px; line-height: 1.2;
}
.back .declension {
  font-size: 0.95rem; color: #6a1b3e; line-height: 1.5; font-style: italic;
}
.hint { font-size: 0.85rem; color: #d81b60; margin-top: 18px; opacity: 0.7; }
.controls {
  display: flex; gap: 8px; margin-top: 22px;
  flex-wrap: wrap; justify-content: center;
}
button {
  padding: 11px 18px; border: none; border-radius: 14px;
  font-size: 0.92rem; font-weight: 600; cursor: pointer;
  transition: 0.2s; color: #fff;
}
button:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.2); }
button:active { transform: translateY(0); }
.nav-btn { background: #ec407a; }
.nav-btn:hover { background: #d81b60; }
.know-btn {
  background: linear-gradient(135deg, #f06292, #e91e63);
  padding: 11px 22px; font-size: 0.95rem;
}
.know-btn:hover { background: linear-gradient(135deg, #ec407a, #c2185b); }
.shuffle { background: #ba68c8; }
.shuffle:hover { background: #ab47bc; }
.list-btn { background: #f48fb1; color: #6a1b3e; }
.list-btn:hover { background: #f06292; color: #fff; }
.progress-bar {
  width: 100%; max-width: 520px; height: 8px;
  background: #ffd6e7; border-radius: 4px; margin-top: 18px; overflow: hidden;
}
.progress-fill {
  height: 100%; background: linear-gradient(90deg, #f06292, #c2185b);
  transition: width 0.3s;
}
.modal {
  display: none; position: fixed; inset: 0;
  background: rgba(90, 42, 62, 0.6);
  z-index: 100; align-items: center; justify-content: center;
  padding: 20px;
}
.modal.open { display: flex; }
.modal-content {
  background: #fff0f5; border-radius: 20px;
  width: 100%; max-width: 560px; max-height: 85vh;
  display: flex; flex-direction: column;
  box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  border: 3px solid #f48fb1;
}
.modal-header {
  padding: 18px 22px; border-bottom: 2px solid #ffd6e7;
  display: flex; justify-content: space-between; align-items: center;
}
.modal-header h2 { font-size: 1.15rem; color: #ad1457; }
.close-btn {
  background: transparent; color: #ad1457; font-size: 1.5rem;
  padding: 0 8px; line-height: 1;
}
.close-btn:hover { color: #d81b60; transform: none; box-shadow: none; }
.modal-tabs { display: flex; border-bottom: 2px solid #ffd6e7; }
.tab {
  flex: 1; padding: 12px; text-align: center; cursor: pointer;
  font-weight: 600; color: #d81b60; background: transparent;
  border: none; border-radius: 0; font-size: 0.9rem;
}
.tab.active { background: #ffd6e7; color: #880e4f; }
.tab:hover:not(.active) { background: #ffe4ec; box-shadow: none; transform: none; }
.modal-body { overflow-y: auto; padding: 16px 22px; flex: 1; }
.modal-body ul { list-style: none; }
.modal-body li {
  padding: 10px 12px; margin-bottom: 6px;
  background: #fff; border-radius: 10px;
  border-left: 4px solid #f48fb1;
  font-size: 0.9rem;
}
.modal-body li .ru { font-weight: 600; color: #880e4f; }
.modal-body li .la { color: #6a1b3e; font-size: 0.85rem; margin-top: 3px; font-style: italic; }
.empty-msg { text-align: center; color: #d81b60; padding: 30px; font-style: italic; }
.stats { padding: 10px 22px; font-size: 0.85rem; color: #ad1457; text-align: center; }
@media (max-width: 480px) {
  .front .translation { font-size: 1.5rem; }
  .back .term { font-size: 1.3rem; }
  .back .declension { font-size: 0.85rem; }
  .controls { gap: 6px; }
  button { padding: 9px 14px; font-size: 0.85rem; }
}
</style>
</head>
<body>
<h1>🌸 Латинские анатомические карточки</h1>
<div class="counter" id="counter">1 / N</div>

<div class="scene">
  <div class="card" id="card" onclick="flip()">
    <div class="face front">
      <div class="translation" id="frontTranslation"></div>
      <div class="hint">нажми, чтобы увидеть латынь</div>
    </div>
    <div class="face back">
      <div class="term" id="backTerm"></div>
      <div class="declension" id="backDeclension"></div>
    </div>
  </div>
</div>

<div class="progress-bar"><div class="progress-fill" id="progress"></div></div>

<div class="controls">
  <button class="nav-btn" onclick="prev()">← Назад</button>
  <button class="know-btn" onclick="markKnown()">Знаю, блять ✅</button>
  <button class="nav-btn" onclick="next()">Вперёд →</button>
</div>
<div class="controls" style="margin-top:10px">
  <button class="shuffle" onclick="shuffle()">🔀 Перемешать</button>
  <button class="list-btn" onclick="openModal()">📋 Списки (знаю / не знаю)</button>
</div>

<div class="modal" id="modal" onclick="if(event.target===this)closeModal()">
  <div class="modal-content">
    <div class="modal-header">
      <h2>📋 Мои карточки</h2>
      <button class="close-btn" onclick="closeModal()">×</button>
    </div>
    <div class="modal-tabs">
      <button class="tab active" id="tabUnknown" onclick="switchTab('unknown')">🤔 Не знаю (<span id="cntUnknown">0</span>)</button>
      <button class="tab" id="tabKnown" onclick="switchTab('known')">✅ Знаю (<span id="cntKnown">0</span>)</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="stats" id="stats"></div>
  </div>
</div>

<script>
